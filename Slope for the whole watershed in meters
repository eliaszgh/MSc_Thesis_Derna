//to load data (from asset)
var dem = ee.Image("projects/ee-eliasgeorgeszgheib/assets/Filled_DEM_Derna");
var basin = ee.FeatureCollection("projects/ee-eliasgeorgeszgheib/assets/wadi_derna");

//to calculate slope in degrees
var slope_deg = ee.Terrain.slope(dem);

//to convert slope from degrees to m/m using tangent
var slope_mpm = slope_deg.multiply(Math.PI).divide(180).tan();

//to clip the slope to derna watershed
var slope_mpm_clipped = slope_mpm.clip(basin);

//to visualize
Map.centerObject(basin, 11);
Map.addLayer(slope_mpm_clipped, {min: 0, max: 1, palette: ['white', 'blue', 'green', 'red']}, 'Slope (m/m)');

//to calculate mean slope (m/m) for the watershed
var meanSlope_mpm = slope_mpm.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: basin.geometry(),
  scale: 30,
  maxPixels: 1e9
});
print('Mean slope of Wadi Derna (m/m):', meanSlope_mpm.get('slope'));
