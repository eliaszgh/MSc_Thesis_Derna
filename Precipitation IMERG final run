//to load derna watershed shapefile (from assets)
var basin = ee.FeatureCollection("projects/ee-eliasgeorgeszgheib/assets/wadi_derna");

//to define time range: 09 Sep 2023 00:00 to 12 Sep 2023 00:00
var start = ee.Date('2023-09-09T00:00');
var end = ee.Date('2023-09-12T00:00');

//to load IMERG Final Run Half-Hourly dataset (Version 06)
var imerg = ee.ImageCollection("NASA/GPM_L3/IMERG_V06")
              .filterDate(start, end)
              .filterBounds(basin)
              .select('precipitationCal'); // Units: mm/hr

// Display one image for reference
Map.centerObject(basin, 9);
Map.addLayer(imerg.first(), {min: 0, max: 20, palette: ['white', 'blue', 'purple']}, 'First Image');
Map.addLayer(basin, {}, 'Wadi Derna');

// ------------------------------------
//to reduce time series over derna basin. 5000 stand for 5k --> 0.1° grid
var timeSeries = imerg.map(function(image) {
  var mean = image.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: basin,
    scale: 5000,
    maxPixels: 1e13
  });

  return ee.Feature(null, {
    'datetime': image.date().format('YYYY-MM-dd HH:mm'),
    'precip_mm_per_hr': mean.get('precipitationCal')
  });
});

//to export
print('IMERG half-hourly precipitation (mm/hr):', timeSeries);

Export.table.toDrive({
  collection: timeSeries,
  description: 'IMERG_HalfHourly_WadiDerna_Sept2023',
  fileFormat: 'CSV'
});