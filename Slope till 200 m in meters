// 2. Mask the DEM to only include areas between 850 and 200 m
var maskedDEM = dem.updateMask(dem.gte(200).and(dem.lte(850)));

// 3. Calculate slope in degrees over the masked DEM
var slope_deg = ee.Terrain.slope(maskedDEM);

// 4. Convert slope to m/m
var slope_mpm = slope_deg.multiply(Math.PI).divide(180).tan();

// 5. Clip to watershed
var slope_mpm_clipped = slope_mpm.clip(basin);

// 6. Display on map
Map.centerObject(basin, 11);
Map.addLayer(slope_mpm_clipped, {min: 0, max: 1, palette: ['white', 'blue', 'green', 'red']}, 'Slope (m/m, 850m–200m)');

// 7. Calculate mean slope (m/m) only for areas between 850 m and 200 m
var meanSlope_mpm = slope_mpm.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: basin.geometry(),
  scale: 30,
  maxPixels: 1e9
});

print('Mean slope (m/m) for elevation range 850–200 m:', meanSlope_mpm.get('slope'));
