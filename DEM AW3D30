// =======================================

// 1. Load ALOS DEM
var dataset = ee.ImageCollection('JAXA/ALOS/AW3D30/V3_2');
var elevation = dataset.select('DSM');

// 2. Define Wadi Derna bounding box
var adjustedArea = ee.Geometry.Rectangle([21.40, 32.465, 23.18, 32.945]);

// 3. Mosaic and clip to area
var elevationMosaic = elevation.mosaic().clip(adjustedArea);

// 4. Visualization settings
var elevationVis = {
  min: 0,
  max: 3000,
  palette: ['0000ff', '00ffff', 'ffff00', 'ff0000', 'ffffff']
};

// 5. Show raw DEM
Map.centerObject(adjustedArea, 9);
Map.addLayer(elevationMosaic, elevationVis, 'Raw DEM');

// 6. Fill depressions to create hydrologically conditioned DEM
var filledDEM = ee.Terrain.fillMinima(elevationMosaic);
Map.addLayer(filledDEM, elevationVis, 'Depressionless DEM');

// 7. Rectangle overlay
var rectFeature = ee.FeatureCollection([ee.Feature(adjustedArea)]);
var rectStyle = {color: 'red', fillColor: '00000000', width: 2};
Map.addLayer(rectFeature.style(rectStyle), {}, 'Clipping Rectangle');

//8 Export raw dem
Export.image.toDrive({
  image: elevationMosaic,
  description: 'Raw_DEM_WadiDerna',
  folder: 'GEE_Exports',
  fileNamePrefix: 'Raw_DEM_WadiDerna',
  region: adjustedArea,
  scale: 30,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});
