// 1. Load your land use map
var landuse = ee.Image("projects/ee-eliasgeorgeszgheib/assets/reprojected_landcover");

// 2. Reclassify to Manning's n
var landuse_classes = [10, 20, 30];  // Adjust based on your data
var manning_values = [0.03, 0.05, 0.1];  // Adjust as needed
var manning_n = landuse.remap(landuse_classes, manning_values).rename('Manning_n');

// 3. Sample points from the image
var samplePoints = manning_n.sample({
  region: landuse.geometry(),
  scale: 30,
  numPixels: 5000, // Limit number of rows for performance; remove for full export
  geometries: true // include lat/lon
});

// 4. Export to CSV
Export.table.toDrive({
  collection: samplePoints,
  description: 'Manning_n_CSV',
  fileFormat: 'CSV'
});
