// 1. Load your shapefile from assets
var wadiDerna = ee.FeatureCollection("projects/ee-eliasgeorgeszgheib/assets/wadi_derna_watershed_delineated");

// 2. Define the date range
var startDate = ee.Date('2023-09-09T00:00');
var endDate = ee.Date('2023-09-13T00:00'); // end is exclusive in Earth Engine

// 3. Load GPM IMERG hourly precipitation data (Version 6)
var imerg = ee.ImageCollection("NASA/GPM_L3/IMERG_V06")
  .filterDate(startDate, endDate)
  .select('precipitationCal'); // calibrated precipitation in mm/hr

// 4. Calculate mean hourly precipitation over the watershed
var hourlyPrecip = imerg.map(function(img) {
  var clipped = img.clip(wadiDerna);
  var stats = clipped.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: wadiDerna.geometry(),
    scale: 10000,
    maxPixels: 1e9
  });
  
  return ee.Feature(null, {
    'datetime': img.date().format('YYYY-MM-dd HH:mm'),
    'precip_mm_hr': stats.get('precipitationCal')
  });
});

// 5. Export the results as a CSV to Google Drive
Export.table.toDrive({
  collection: hourlyPrecip,
  description: 'IMERG_Hourly_WadiDerna_20230909_20230912',
  fileFormat: 'CSV'
});

// 6. Optional: Visualize the catchment and a sample precipitation image
Map.centerObject(wadiDerna, 9);
Map.addLayer(wadiDerna, {color: 'blue'}, 'Wadi Derna Catchment');
Map.addLayer(imerg.first(), {min: 0, max: 10, palette: ['white', 'blue']}, 'Sample Precipitation');

